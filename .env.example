# compose 一撃で使う環境変数。cp .env.example .env して埋める。
# 本番デプロイ:  docker compose up -d --build

# TLSを取るドメイン（Lightsailの静的IPをここに向けておく）。
# ローカル確認は  DOMAIN=:80  にすると http://localhost で見られる
DOMAIN=example.com

# ゲストCookie署名の秘密。必ずランダムな長い値に置き換える（例: openssl rand -hex 32）
COOKIE_SECRET=change-me-to-a-long-random-string
